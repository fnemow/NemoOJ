{
  "name": "nemo-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && node scripts/compress-assets.mjs",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/vue-query": "5.90.2",
    "dompurify": "3.2.6",
    "element-plus": "2.11.4",
    "idb": "8.0.3",
    "markdown-it": "14.1.0",
    "monaco-editor": "0.52.2",
    "pinia": "3.0.3",
    "vue": "3.5.22",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.55.1",
    "@types/node": "22.18.6",
    "@types/markdown-it": "14.1.2",
    "@vitejs/plugin-vue": "6.0.1",
    "@vitest/coverage-v8": "3.2.4",
    "@vue/eslint-config-typescript": "14.6.0",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.36.0",
    "eslint-plugin-vue": "10.5.0",
    "jsdom": "27.0.0",
    "typescript": "5.9.2",
    "vite": "7.1.7",
    "vitest": "3.2.4",
    "vue-tsc": "3.0.8"
  }
}
