<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.nemo</groupId>
    <artifactId>nemo-sandbox</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>nemo-sandbox</name>
    <description>nemo-sandbox</description>
    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <spring-boot.version>3.5.16</spring-boot.version>
        <maven.surefire.version>3.6.0</maven.surefire.version>
        <!-- Compatible security overrides; keep entire library families aligned. -->
        <security.jackson.version>2.21.8</security.jackson.version>
        <security.netty.version>4.1.139.Final</security.netty.version>
        <security.log4j.version>2.26.1</security.log4j.version>
        <security.tomcat.version>10.1.61</security.tomcat.version>
        <security.bouncycastle.version>1.86</security.bouncycastle.version>
        <security.rabbitmq.version>5.37.0</security.rabbitmq.version>
        <security.httpclient5.version>5.6.3</security.httpclient5.version>
        <security.httpcore5.version>5.4.3</security.httpcore5.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- https://hutool.cn/docs/index.html#/-->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>5.8.47</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Only core + the selected HTTP5 transport; exclude unused legacy Jersey transport. -->
        <dependency>
            <groupId>com.github.docker-java</groupId>
            <artifactId>docker-java-core</artifactId>
            <version>3.7.1</version>
        </dependency>
        <!-- https://mvnrepository.com/artifact/com.github.docker-java/docker-java-transport-httpclient5 -->
        <dependency>
            <groupId>com.github.docker-java</groupId>
            <artifactId>docker-java-transport-httpclient5</artifactId>
            <version>3.7.1</version>
        </dependency>
        <!-- 监控：健康检查与指标端点（T10） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- Gson (用于沙箱复制 JAR 到 Docker workspace) -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.14.0</version>
        </dependency>
    </dependencies>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.apache.httpcomponents.client5</groupId><artifactId>httpclient5</artifactId>
                <version>${security.httpclient5.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents.core5</groupId><artifactId>httpcore5</artifactId>
                <version>${security.httpcore5.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents.core5</groupId><artifactId>httpcore5-h2</artifactId>
                <version>${security.httpcore5.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId><artifactId>commons-lang3</artifactId>
                <version>3.20.0</version>
            </dependency>
            <!-- Overrides precede the Boot BOM; imported BOM order is significant. -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${security.jackson.version}</version>
                <type>pom</type><scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>${security.netty.version}</version>
                <type>pom</type><scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-bom</artifactId>
                <version>${security.log4j.version}</version>
                <type>pom</type><scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId><artifactId>tomcat-embed-core</artifactId>
                <version>${security.tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId><artifactId>tomcat-embed-el</artifactId>
                <version>${security.tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId><artifactId>tomcat-embed-websocket</artifactId>
                <version>${security.tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId><artifactId>bcprov-jdk18on</artifactId>
                <version>${security.bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId><artifactId>bcpkix-jdk18on</artifactId>
                <version>${security.bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId><artifactId>bcutil-jdk18on</artifactId>
                <version>${security.bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rabbitmq</groupId><artifactId>amqp-client</artifactId>
                <version>${security.rabbitmq.version}</version>
            </dependency>

            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                    <encoding>UTF-8</encoding>
                    <!-- 同父 POM：Spring 6 需要编译期参数名，见 OJ-backend-microservice/pom.xml 注释 -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <!-- 显式固定 surefire 版本（Maven 3.6.x 默认 2.12.4 不支持 JUnit 5，会静默跳过测试） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.version}</version>
                <configuration>
                    <!-- 单元测试阶段排除集成测试（*IT 由 failsafe 在 integration profile 中执行） -->
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!--
              把判题运行期需要的第三方库复制成"明确的独立运行库资源"。
              背景：原实现用 Gson.class.getProtectionDomain().getCodeSource().getLocation()
              取得 JAR 路径再复制到工作目录。可执行 Boot JAR 里的依赖位于
              BOOT-INF/lib/，该 URL 形如 jar:file:...!/BOOT-INF/lib/gson-x.jar!/
              并不是一个真实文件，转换为 File 会失败——于是 Gson 没有被放进工作目录，
              Runner 编译报错，最终被误判成用户代码的"编译错误"。
              改为在构建期把 JAR 复制到 classes/sandbox-libs/，运行期按类路径资源读取，
              无论是否嵌套在 Boot JAR 中都能取到。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-sandbox-runtime-libs</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.google.code.gson</groupId>
                                    <artifactId>gson</artifactId>
                                    <outputDirectory>${project.build.outputDirectory}/sandbox-libs</outputDirectory>
                                    <destFileName>gson.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <overWriteReleases>true</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <mainClass>com.nemo.nemosandbox.NemoSandboxApplication</mainClass>
                    <skip>false</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          mvn -P integration verify
          运行集成测试（*IT.java，需要真实 Docker daemon 与判题镜像）。
          默认构建只执行不依赖 Docker 的单元测试。
        -->
        <profile>
            <id>integration</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>${maven.surefire.version}</version>
                        <configuration>
                            <!-- 同父 POM：repackage 会替换主制品，需让 failsafe 使用编译输出目录 -->
                            <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                        </configuration>
                        <executions>
                            <execution>
                                <id>integration-tests</id>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
