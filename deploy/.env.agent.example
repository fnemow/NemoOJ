# 复制为 deploy/.env.agent；此文件只放在阿里云 AI 主机，不提交真实密钥。
# URL 中使用的 PostgreSQL 密码应为 URL 安全字符，例如 openssl rand -hex 24。
NEMO_AGENT_IMAGE=nemo-oj/agent:REPLACE_WITH_RELEASE_TAG
AI_TUNNEL_PEER_IP=10.88.0.1
AI_POSTGRES_DB=langgraph
AI_POSTGRES_USER=langgraph
AI_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD
AI_RABBITMQ_USERNAME=REPLACE_WITH_OJ_RABBITMQ_USERNAME
AI_RABBITMQ_PASSWORD=REPLACE_WITH_OJ_RABBITMQ_PASSWORD
AI_INTERNAL_SECRET=REPLACE_WITH_SAME_OJ_SECRET
AI_MODEL_PROVIDER=openai
AI_MODEL_ID=REPLACE_WITH_MODEL_ID
AI_MODEL_BASE_URL=REPLACE_WITH_PROVIDER_API_BASE_URL
AI_MODEL_API_KEY=REPLACE_WITH_NEW_API_KEY
AI_MODEL_TIMEOUT_SECONDS=45
AI_MODEL_CONCURRENCY=2
AI_AUTO_REPAIR_ENABLED=true
AI_CANONICAL_GENERATION_ENABLED=true
AI_TRUSTED_TEMPLATES_ENABLED=true
AI_STAGED_GENERATION_ENABLED=true
AI_PYTHON_PREFLIGHT_ENABLED=true
AI_EVENT_DRIVEN_VALIDATION_ENABLED=false
AI_INPUT_USD_PER_MILLION_TOKENS=0
AI_OUTPUT_USD_PER_MILLION_TOKENS=0
