[Unit]
Description=NemoOJ encrypted backup and off-host replication
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/nemo-oj/ops.env
ExecStart=/usr/bin/python3 /usr/local/lib/nemo-ops/backup.py --role ${NEMO_ROLE}
UMask=0077
Nice=10
TimeoutStartSec=900
