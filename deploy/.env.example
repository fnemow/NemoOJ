# ============================================================
# NemoOJ 部署环境变量模板
#
# 用法：复制为 deploy/.env 并填写真实值。
#   cp deploy/.env.example deploy/.env
#
# 重要约定：
#   1. **本文件中的值全部是占位符，不是可用凭据**。部署前必须逐个替换。
#   2. deploy/.env 已被 .gitignore 排除，不要提交到版本库。
#   3. 生产缺少这些变量时应用会**启动失败**（不是回退到默认值），这是刻意的。
# ============================================================

# ---------- 镜像版本 ----------
# 用不可变标签或 digest，避免"同一标签内容变了"导致回滚到不确定的产物
NEMO_GATEWAY_IMAGE=nemo-oj/gateway:0.0.1-SNAPSHOT
NEMO_USER_IMAGE=nemo-oj/user-service:0.0.1-SNAPSHOT
NEMO_QUESTION_IMAGE=nemo-oj/question-service:0.0.1-SNAPSHOT
NEMO_JUDGE_IMAGE=nemo-oj/judge-service:0.0.1-SNAPSHOT
NEMO_SANDBOX_IMAGE=nemo-oj/sandbox:0.0.1-SNAPSHOT

# 判题镜像：**必须固定 digest**，可变标签意味着判题环境会悄悄变化
# 获取方式：docker pull openjdk:8-alpine && docker inspect openjdk:8-alpine --format='{{index .RepoDigests 0}}'
SANDBOX_JAVA_IMAGE=openjdk:8-alpine@sha256:REPLACE_WITH_REAL_DIGEST

# ---------- 对外入口 ----------
# 仅反向代理对外暴露；其余服务只在内部网络
PUBLIC_DOMAIN=oj.example.com

# 双机模式才需要：腾讯云 wg0 上的地址，绝不能填公网 IP 或 0.0.0.0
AI_TUNNEL_BIND_IP=10.88.0.1
NEMO_AI_LINK_PROXY_IMAGE=haproxy:3.2.24-alpine

# CORS 白名单：必须是真实域名，不接受通配符
CORS_ALLOWED_ORIGINS=https://oj.example.com
REGISTRATION_ENABLED=false

# 首次 SSH 隧道验收时，将 CORS_ALLOWED_ORIGINS 改成 http://127.0.0.1:18080
# Nacos 2.4+ 首次启用鉴权后必须初始化管理员密码，供服务发现客户端使用。
NACOS_USERNAME=nacos
NACOS_PASSWORD=REPLACE_WITH_RANDOM_NACOS_PASSWORD

# ---------- 数据库 ----------
DB_URL=jdbc:mysql://mysql:3306/nemo_oj?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=REPLACE_ME
DB_PASSWORD=REPLACE_ME
DB_ROOT_PASSWORD=REPLACE_ME
DB_POOL_SIZE=10

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=REPLACE_ME
# Session 与限流计数都依赖 Redis。多实例部署时不可选用本地内存限流，
# 否则配额会按实例数放大。

# ---------- RabbitMQ ----------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=REPLACE_ME
RABBITMQ_PASSWORD=REPLACE_ME
# 消费者并发与预取：与沙箱槽位共同决定实际并发能力
RABBITMQ_PREFETCH=1
RABBITMQ_CONCURRENCY=2
SANDBOX_MAX_CONCURRENT_TASKS=4
SANDBOX_BACKGROUND_IDLE_GRACE_MS=1000
SANDBOX_BACKGROUND_MAX_CONCURRENT=2
SANDBOX_FOREGROUND_BACKGROUND_WAIT_MS=15000
SANDBOX_BACKGROUND_MIN_AVAILABLE_MEMORY_KB=524288
# 仅 compose.core-4g-preview.yml 使用的独立小主机容量覆盖。
# 默认为 1；本轮 4 核 4 GB 双机验收通过后，云端实际配置为 2 / 2。
NEMO_CORE_JUDGE_CONCURRENCY=1
NEMO_CORE_SANDBOX_SLOTS=1
QUESTION_TOMCAT_MAX_THREADS=32
# Only enable both split-protocol flags after building and validating the matching pinned C++ image.
JUDGE_CPP_SPLIT_PROTOCOL_ENABLED=false
SANDBOX_CPP_SPLIT_PROTOCOL_ENABLED=false
SANDBOX_ORPHAN_MIN_AGE_MS=900000
SANDBOX_REAPER_INTERVAL_MS=300000

# ---------- Nemo Agent / LangChain / LangGraph ----------
# 所有功能默认关闭。填入真实模型 API 并配置预算后，由运维逐项开启。
AI_ANALYSIS_ENABLED=false
AI_LEARNING_ENABLED=false
AI_PRIVATE_PROBLEMS_ENABLED=false
AI_FEEDBACK_ENABLED=false
AI_MAINTENANCE_ENABLED=false
AI_MODEL_ENABLED=false
AI_MODEL_PROVIDER=openai
AI_MODEL_ID=
AI_MODEL_API_KEY=
AI_MODEL_BASE_URL=
AI_INTERNAL_SECRET=REPLACE_WITH_RANDOM_32_HEX
AI_ENVIRONMENT=production
AI_MOCK_ENABLED=false
AI_ANALYSIS_PER_DAY=5
AI_TASKS_PER_MINUTE=5
AI_DAILY_BUDGET_USD=0
AI_MAX_TASK_BUDGET_USD=0
AI_MODEL_MAX_ATTEMPTS=2
AI_ESCALATION_EMAIL=
AI_INPUT_USD_PER_MILLION_TOKENS=0
AI_OUTPUT_USD_PER_MILLION_TOKENS=0
AI_MODEL_TIMEOUT_SECONDS=45
AI_POSTGRES_DB=langgraph
AI_POSTGRES_USER=langgraph
AI_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_STARTTLS_REQUIRED=false
SMTP_SSL=false
SMTP_SSL_TRUST=

# ---------- Nacos（服务发现）----------
NACOS_SERVER_ADDR=nacos:8848

# ---------- 内部服务凭据 ----------
# 所有业务服务必须配置为**同一个值**，长度 >= 16。
# 生成示例：openssl rand -hex 24
INTERNAL_AUTH_SECRET=REPLACE_WITH_RANDOM_32_HEX

# ---------- 沙箱凭据 ----------
# 判题服务与沙箱服务必须一致，长度 >= 16
SANDBOX_SECRET=REPLACE_WITH_RANDOM_32_HEX
SANDBOX_BASE_URL=http://sandbox:8090

# ---------- 限流阈值（按预发压测结果调整，不要照搬）----------
RATELIMIT_TRUST_XFF=true
# 登录采用滑动窗口；账号和 IP 双层限制，窗口单位为秒。
RATELIMIT_LOGIN_IP=60
RATELIMIT_LOGIN_ACCOUNT=20
RATELIMIT_LOGIN_WINDOW=60
# 正式提交仍采用滑动窗口，另设单用户未完成配额及全局队列容量保护。
RATELIMIT_SUBMIT_USER=20
RATELIMIT_SUBMIT_IP=60
RATELIMIT_SUBMIT_WINDOW=60
RATELIMIT_SUBMIT_PENDING=8

# ---------- 判题参数 ----------
JUDGE_LEASE_SECONDS=120
JUDGE_LEASE_MAX_ATTEMPTS=3
OUTBOX_MAX_RETRIES=8

# ---------- 日志 ----------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO

# ---------- 备份 ----------
# 备份保留天数；与 RUNBOOK.md 中的 RPO/RTO 说明对应
BACKUP_RETENTION_DAYS=7

# 全局正式判题准入，包含未投递、排队和运行中的公开/私人提交。
JUDGE_ADMISSION_MAX_PENDING=12
JUDGE_ADMISSION_MAX_OLDEST_SECONDS=120
JUDGE_ADMISSION_RETRY_AFTER_SECONDS=5
# 包括私人题生成的 schema 修复调用；每次调用另行预留平台预算。
AI_MODEL_MAX_CALLS_PER_TASK=4
AI_CATALOG_PLANS_ENABLED=true
AI_PRIVATE_BATCHES_ENABLED=true
# 一份后台验证最多并行两种语言/模式；完整验证任务全局仍为一个。
AI_PRIVATE_VALIDATION_COMBINATION_CONCURRENCY=2
